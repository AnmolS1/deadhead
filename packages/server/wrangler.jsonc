{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // `ponderance-play` — the game backend. See CLAUDE.md → Architecture.
  //
  // This Worker has **no `routes` block, deliberately**. The site
  // (`ponderance-prod`) reaches it through a service binding named `PLAY`, and
  // `ponderance`'s own `wrangler-routes.sh` gate requires the site to declare
  // exactly two routes with no wildcards. A route here would not trip that gate
  // — it is a different Worker — but it would give the game a second public
  // origin, and `connect-src 'self'` is the whole reason this is same-origin.
  //
  // Deploys independently of the site: the Astro adapter *generates* the site's
  // wrangler config, so Durable Object class exports and namespace lifecycle
  // must not live in a file the build regenerates. That is the entire reason
  // this package exists separately.
  "name": "ponderance-play",
  "main": "src/worker.ts",

  // Two things are going on in this one line.
  //
  // 1. **No `compatibility_flags`.** On 2026-08-04 and later, `nodejs_compat`
  //    and `nodejs_compat_v2` are enabled **by default** by the compatibility
  //    date itself; Wrangler, Miniflare and Vitest Pool Workers ignore the
  //    flags as redundant. `B-01`'s brief says to set
  //    `compatibility_flags: ["nodejs_compat"]` — that predates the change and
  //    is stale. Do not add it back: a no-op that reads as a requirement is
  //    worse than nothing.
  //    https://developers.cloudflare.com/changelog/post/2026-08-04-nodejs-compat-default/
  //
  // 2. **This is NOT today's date, and it cannot be.** Cloudflare's
  //    best-practices guide says to set it to today; taken literally that does
  //    not boot. The ceiling is the newest date the *installed* `workerd`
  //    supports — 2026-08-18 for the binary behind wrangler 4.123.0 — and a
  //    later date fails at runtime startup, not at config validation:
  //      `This Worker requires compatibility date "2026-08-21", but the newest
  //       date supported by this server binary is "2026-08-18".`
  //    Raise this only together with the wrangler pin, and only after
  //    `npm -w @deadhead/server test` passes.
  "compatibility_date": "2026-08-18",

  // **No public route, and that includes workers.dev.** `wrangler deploy` enables
  // the `*.workers.dev` subdomain by DEFAULT, and the first deploy of this Worker
  // duly published https://ponderance-play.discoinferno.workers.dev — a live,
  // unauthenticated route straight to the game API, bypassing the site, its CSP,
  // and the same-origin assumption the whole architecture rests on. Verified by
  // curling it: 200, full binding report.
  //
  // That is harmless for a health endpoint and NOT harmless once B-06 mints run
  // tokens and B-07 accepts submissions. This Worker must be reachable only
  // through the site's PLAY service binding.
  //
  // `workers_dev: false` is the fix. Do not "fix" it by adding `routes` instead:
  // wrangler-routes.sh in the site repo requires exactly two, and a route here
  // would be a third public door rather than none.
  "workers_dev": false,

  "observability": { "enabled": true },

  // Durable Object class lifecycle, declared with the **`exports` map**.
  //
  // `exports` and the legacy `migrations` array are mutually exclusive. Not
  // just documented — **measured**: adding a `migrations` array alongside this
  // map makes wrangler refuse the config outright, with
  //   "`migrations` and `exports` are mutually exclusive. Choose one or the
  //    other to declare your Durable Object lifecycle, but not both."
  // `exports` is declarative: it is
  // compared against what is deployed, so renames and deletes are edits to this
  // map rather than an append-only tagged history.
  //
  // `"storage": "sqlite"` is not a preference. It is the only backend a new
  // namespace can be created with, and the only one the Workers Free plan has
  // ever supported.
  "exports": {
    "LobbyRoom": { "type": "durable-object", "storage": "sqlite" },
    "MatchRoom": { "type": "durable-object", "storage": "sqlite" },
    "Matchmaker": { "type": "durable-object", "storage": "sqlite" },
  },

  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "LobbyRoom" },
      { "name": "MATCH", "class_name": "MatchRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
    ],
  },

  // Real database, created 2026-08-27. **Primary region WNAM, deliberately.**
  // `wrangler d1 create` with no --location picked APAC, which would put every
  // leaderboard write and every replay validation a Pacific crossing away from
  // both the author and the audience. D1's primary location is IMMUTABLE after
  // creation, so the only free moment to fix it is before the first table
  // exists. It was fixed there. Every other database in this account is WNAM;
  // if a future one disagrees, it was created without the flag.
  //
  // Local dev and `migrations apply --local` never read `database_id` — they
  // use the SQLite file under `.wrangler/` — so a wrong id here stays invisible
  // until a real deploy or a `--remote` migration.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deadhead",
      "database_id": "d9ff8aac-1fc0-4014-8d38-e9702c8c3cff",
      "migrations_dir": "migrations",
    },
  ],

  // Real namespace, created 2026-08-27. Its TITLE is `deadhead-kv`, which appears
  // nowhere in this file — a KV binding is matched by id alone, so the only way
  // to tell which namespace this is from the config is this comment. Keep it.
  // (Created from a config-free directory on purpose: run inside a workspace,
  // `kv namespace create` prefixes the title with the Worker name and you get
  // `ponderance-play-RATE_LIMIT` instead of the estate's `<project>-kv` shape.)
  //
  // **One namespace, two purposes, and the binding name only describes one.**
  // B-07 uses it for per-user and per-IP submission rate limits; B-06 stores
  // single-use run tokens in it with a TTL. That is deliberate rather than
  // sloppy — KV is a keyspace and a second namespace would buy nothing — but it
  // means keys MUST be prefixed by purpose (`rl:` / `run:`) so the two cannot
  // collide, and so a purge of one does not take the other. Do not rename the
  // binding to suit whichever task you are in; rename nothing, prefix keys.
  //
  // Distinct from the SITE's own
  // RATE_LIMIT namespace (2b67b00d…), which serves /api/inquiry — same binding
  // name, different Worker, different namespace. Do not merge them.
  "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "7ac995c09cff4bf9aebbfdb705f03c1c" }],
}
